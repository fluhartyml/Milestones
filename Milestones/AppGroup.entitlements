<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  REM: amber B-031.3 / B-031.5 — the App Group the Share extension drops shares into (Shared/ShareInbox.swift).
  "milestones would definitely need a share entrypoint." A file of its own, not Milestones.entitlements: that file was
  never wired to the target (no CODE_SIGN_ENTITLEMENTS), and wiring it now would also switch on iCloud, push and
  WeatherKit in the same change. This adds only the App Group.
-->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.inkwell.Milestones</string>
	</array>
</dict>
</plist>
